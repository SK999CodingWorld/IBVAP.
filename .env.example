# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ibvap
POSTGRES_USER=ibvap
POSTGRES_PASSWORD=ibvap_secret

# Detection
DETECTION_MODEL=yolov8n.pt
DETECTION_DEVICE=auto
DETECTION_CONF=0.35
DETECTION_IOU=0.45
DETECTION_CLASSES=[0,1,2,3,5,7]
DETECTION_IMGSZ=640
DETECTION_HALF=false

# Tracking
TRACKER_TYPE=botsort
TRACKER_CONFIG=botsort.yaml
TRACK_BUFFER=30
MATCH_THRESH=0.8

# Zones
ZONES_CONFIG=zones.json

# Alerts
ALERT_COOLDOWN=5.0
ALERT_MAX_HISTORY=1000

# Recording
RECORD_ENABLED=false
RECORD_SEGMENT_DURATION=300
RECORD_RETENTION_DAYS=30
RECORD_PATH=./recordings

# API & Security
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1
SECRET_KEY=change-this-in-production-to-a-secure-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=1440
DATABASE_URL=sqlite+aiosqlite:///./ibvap.db
REDIS_URL=redis://localhost:6379
DEMO_MODE=false
DEMO_ADMIN_USERNAME=admin
DEMO_ADMIN_PASSWORD=admin123
AI_BACKEND=mock
EDGE_NODE_ID=EDGE-001
RATE_LIMIT_PER_MINUTE=60

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json