# ==============================================================================
# IBVAP Environment Variables & Secrets Configuration Template
# ==============================================================================
# Copy this file to '.env' in your local environment.
# In CI (GitHub Actions), add SECRET_KEY and DATABASE_URL under repository secrets.
# In Railway/Render, set these as Service Environment Variables.

# --- Environment & Host ---
ENVIRONMENT=development                # development | production | test
HOST=0.0.0.0
PORT=8000

# --- Security & JWT Authentication ---
# In production, must be at least 32 characters generated securely:
# e.g.: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=supersecretkey-change-in-production-ibvap-safe-dev-key
ACCESS_TOKEN_EXPIRE_MINUTES=1440
WEBHOOK_SECRET=ibvap_webhook_signature_secret_32bytes_change_in_prod

# --- Database (Async SQLAlchemy) ---
# Local SQLite default:
DATABASE_URL=sqlite+aiosqlite:///./ibvap.db
# Production PostgreSQL (Railway / Supabase / Neon):
# Format: postgresql+asyncpg://<username>:<password>@<host>:<port>/<database>
# Note: Railway provides 'postgres://...' or 'postgresql://...' which IBVAP auto-normalizes.

# --- Connection Pool Tuning (PostgreSQL only) ---
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800

# --- Redis & Distributed Caching ---
# Optional: falls back to ultra-fast in-memory TTL cache if Redis is unavailable
REDIS_URL=redis://localhost:6379

# --- CORS & Network Protection ---
# Comma-separated or JSON list of allowed frontend origins in production
# e.g. ["https://your-app.railway.app", "https://your-frontend.vercel.app"]
CORS_ORIGINS=["*"]
RATE_LIMIT_PER_MINUTE=120
MAX_REQUEST_SIZE_BYTES=10485760

# --- Feature Flags ---
DEMO_MODE=true
DEMO_ADMIN_USERNAME=admin
DEMO_ADMIN_PASSWORD=admin123
ENABLE_KEY_HEALTH_CHECK=false
AI_BACKEND=mock
EDGE_NODE_ID=EDGE-001
